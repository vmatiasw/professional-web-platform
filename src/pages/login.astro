---
import '../styles/global.css';

const nextPath = Astro.url.searchParams.get('next')?.startsWith('/') ? Astro.url.searchParams.get('next') : '/admin';
if (Astro.locals.user) {
  return Astro.redirect(nextPath ?? '/admin');
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Iniciar sesión | Professional Web Platform</title>
  </head>
  <body class="min-h-screen bg-stone-100 text-stone-900">
    <main class="mx-auto flex min-h-screen max-w-md items-center px-6 py-12">
      <form id="login-form" class="w-full space-y-6 rounded border border-stone-300 bg-white p-8 shadow-sm">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-stone-500">Administración</p>
          <h1 class="mt-2 text-3xl font-medium">Iniciar sesión</h1>
        </div>
        <label class="block text-sm">Email<input name="email" type="email" autocomplete="email" required class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label>
        <label class="block text-sm">Contraseña<input name="password" type="password" autocomplete="current-password" required class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label>
        <button type="submit" class="w-full bg-stone-900 px-4 py-3 text-white">Entrar</button>
        <p id="login-error" class="min-h-5 text-sm text-red-700" role="alert"></p>
      </form>
    </main>
  </body>
</html>

<script define:vars={{ nextPath }}>
  import { createSupabaseBrowserClient } from '../lib/supabase/browser';

  const form = document.querySelector<HTMLFormElement>('#login-form');
  const error = document.querySelector<HTMLElement>('#login-error');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !error) return;
    error.textContent = '';
    const values = new FormData(form);
    const { error: signInError } = await createSupabaseBrowserClient().auth.signInWithPassword({
      email: String(values.get('email')),
      password: String(values.get('password'))
    });
    if (signInError) {
      error.textContent = signInError.message;
      return;
    }
    window.location.assign(nextPath);
  });
</script>