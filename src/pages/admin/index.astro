---
import '../../styles/global.css';
import { getBusinessContext } from '../../lib/admin/business';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const context = user && supabase ? await getBusinessContext(supabase, user, Astro.cookies) : { active: null, memberships: [] };
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Administración | Professional Web Platform</title>
  </head>
  <body class="min-h-screen bg-stone-100 text-stone-900">
    <header class="border-b border-stone-300 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/admin" class="font-medium">Professional Web Platform</a>
        <form method="post" action="/api/logout"><button type="submit" class="text-sm underline">Cerrar sesión</button></form>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-12">
      <p class="text-sm text-stone-500">Sesión activa: {user?.email}</p>
      <h1 class="mt-2 text-4xl font-medium">Panel administrativo</h1>
      <section class="mt-10 grid gap-4 md:grid-cols-4">
        {[['Contenido', '/admin/entries'], ['Multimedia', '/admin/media'], ['Personas', '/admin/people'], ['Configuración', '/admin/settings']].map(([label, href]) => (
          <a href={href} class="border border-stone-300 bg-white p-5 hover:border-stone-900">
            <h2 class="font-medium">{label}</h2>
            <p class="mt-2 text-sm text-stone-500">Próximamente</p>
          </a>
        ))}
      </section>
      <section class="mt-10 border border-stone-300 bg-white p-6">
        <h2 class="text-xl font-medium">Businesses disponibles</h2>
        {context.memberships.length ? (
          <ul class="mt-4 space-y-3">
            {context.memberships.map(({ role, business }) => <li class="flex items-center justify-between border-t border-stone-200 pt-3"><span>{business.name}</span><span class="text-sm text-stone-500">{role}</span></li>)}
          </ul>
        ) : <p class="mt-4 text-sm text-stone-500">No hay un business asociado a este usuario.</p>}
      </section>
      {context.memberships.length > 1 && <form method="post" action="/api/admin/business" class="mt-6 border border-stone-300 bg-white p-6"><label class="block text-sm">Business activo<select name="business_id" class="mt-2 block w-full border border-stone-300 px-3 py-2">{context.memberships.map(({ business_id, business }) => <option value={business_id} selected={context.active?.business_id === business_id}>{business.name}</option>)}</select></label><button class="mt-4 bg-stone-900 px-4 py-3 text-sm text-white" type="submit">Cambiar business</button></form>}
    </main>
  </body>
</html>