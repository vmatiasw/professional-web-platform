---
import '../../styles/global.css';
import { getBusinessContext } from '../../lib/admin/business';
import type { Entry, EntryMedia, Media } from '../../types/database';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const context = user && supabase ? await getBusinessContext(supabase, user, Astro.cookies) : { active: null, memberships: [] };
const { data: entryData } = context.active && supabase ? await supabase.from('entries').select('id, title').eq('business_id', context.active.business_id).order('title') : { data: [] };
const entries = (entryData ?? []) as unknown as Pick<Entry, 'id' | 'title'>[];
const { data: linkData } = context.active && supabase ? await supabase.from('entry_media').select('entry_id, media_id, sort_order, is_featured').in('entry_id', entries.map((entry) => entry.id)).order('sort_order') : { data: [] };
const links = (linkData ?? []) as unknown as EntryMedia[];
const { data: mediaData } = context.active && supabase ? await supabase.from('media').select('*').eq('business_id', context.active.business_id).order('sort_order') : { data: [] };
const media = (mediaData ?? []) as unknown as Media[];
const error = Astro.url.searchParams.get('error');
---

<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Multimedia | Administración</title></head><body class="min-h-screen bg-stone-100 text-stone-900"><main class="mx-auto max-w-5xl px-6 py-10"><a href="/admin" class="text-sm text-stone-500">← Panel</a><h1 class="mt-2 text-4xl font-medium">Multimedia</h1><p class="mt-2 text-stone-600">{context.active?.business.name}</p>{error && <p class="mt-4 text-red-700">No se pudo completar la operación.</p>}<form method="post" action="/api/admin/media" enctype="multipart/form-data" class="mt-8 space-y-5 border border-stone-300 bg-white p-6"><h2 class="text-xl font-medium">Subir imagen</h2><label class="block text-sm">Contenido<select required name="entry_id" class="mt-2 block w-full border border-stone-300 px-3 py-2">{entries.map((entry) => <option value={entry.id}>{entry.title}</option>)}</select></label><label class="block text-sm">Archivo<input required name="file" type="file" accept="image/*" class="mt-2 block w-full" /></label><label class="block text-sm">Texto alternativo<input required name="alt_text" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm">Orden<input name="sort_order" type="number" value="0" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="flex items-end gap-2 pb-2 text-sm"><input name="is_featured" type="checkbox" /> Imagen destacada</label></div><button type="submit" class="bg-stone-900 px-4 py-3 text-white">Subir imagen</button></form><section class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{media.map((item) => { const link = links.find((candidate) => candidate.media_id === item.id); const entry = entries.find((candidate) => candidate.id === link?.entry_id); const url = supabase?.storage.from('site-images').getPublicUrl(item.storage_path).data.publicUrl; return <article class="border border-stone-300 bg-white p-3"><img src={url} alt={item.alt_text ?? ''} width={item.width ?? 400} height={item.height ?? 300} class="aspect-4/3 w-full object-cover" /><p class="mt-3 text-sm">{entry?.title ?? 'Sin asociación'}{link?.is_featured ? ' · Destacada' : ''}</p><form method="post" action="/api/admin/media" class="mt-2"><input type="hidden" name="_action" value="delete" /><input type="hidden" name="media_id" value={item.id} /><button class="text-sm text-red-700 underline" type="submit">Eliminar</button></form></article> })}</section></main></body></html>