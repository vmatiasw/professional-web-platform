---
import '../../styles/global.css';
import { getBusinessContext } from '../../lib/admin/business';
import type { Person, Media } from '../../types/database';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const context = user && supabase ? await getBusinessContext(supabase, user, Astro.cookies) : { active: null, memberships: [] };
const editId = Astro.url.searchParams.get('edit');
const { data: peopleData } = context.active && supabase ? await supabase.from('people').select('*').eq('business_id', context.active.business_id).order('sort_order') : { data: [] };
const people = (peopleData ?? []) as unknown as Person[];
const person = people.find((candidate) => candidate.id === editId) ?? null;
const { data: mediaData } = context.active && supabase ? await supabase.from('media').select('*').eq('business_id', context.active.business_id) : { data: [] };
const media = (mediaData ?? []) as unknown as Media[];
const photoUrl = person?.photo_media_id ? supabase?.storage.from('site-images').getPublicUrl(media.find((item) => item.id === person.photo_media_id)?.storage_path ?? '').data.publicUrl : null;
---

<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Personas | Administración</title></head><body class="min-h-screen bg-stone-100 text-stone-900"><main class="mx-auto max-w-5xl px-6 py-10"><a href="/admin" class="text-sm text-stone-500">← Panel</a><h1 class="mt-2 text-4xl font-medium">Personas</h1><p class="mt-2 text-stone-600">{context.active?.business.name}</p><form method="post" action="/api/admin/people" enctype="multipart/form-data" class="mt-8 space-y-5 border border-stone-300 bg-white p-6"><input type="hidden" name="id" value={person?.id ?? ''} /><h2 class="text-xl font-medium">{person ? 'Editar persona' : 'Nueva persona'}</h2><label class="block text-sm">Nombre<input required name="name" value={person?.name ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Rol<input name="role" value={person?.role ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Tipo<select name="kind" class="mt-2 block w-full border border-stone-300 px-3 py-2"><option value="staff" selected={person?.kind === 'staff'}>Staff</option><option value="collaborator" selected={person?.kind === 'collaborator'}>Colaborador</option></select></label><label class="block text-sm">Biografía<textarea name="bio" rows="4" class="mt-2 block w-full border border-stone-300 px-3 py-2">{person?.bio ?? ''}</textarea></label><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm">Foto<input name="photo" type="file" accept="image/*" class="mt-2 block w-full" />{photoUrl && <img src={photoUrl} alt={person?.name} width="100" height="100" class="mt-3 h-20 w-20 object-cover" />}</label><label class="block text-sm">CV<input name="cv" type="file" accept="application/pdf,.pdf" class="mt-2 block w-full" /></label></div><label class="block text-sm">Orden<input name="sort_order" type="number" value={person?.sort_order ?? 0} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="text-sm"><input name="published" type="checkbox" checked={person?.published ?? false} /> Visible en el sitio público</label><div class="flex gap-4"><button class="bg-stone-900 px-4 py-3 text-white" type="submit">Guardar persona</button>{person && <a href="/admin/people" class="px-4 py-3 underline">Cancelar</a>}</div></form><section class="mt-8 space-y-3">{people.map((item) => <article class="flex items-center justify-between border border-stone-300 bg-white p-4"><div><strong>{item.name}</strong><p class="text-sm text-stone-500">{item.role ?? item.kind}{item.published ? ' · Publicado' : ''}</p></div><div class="flex gap-3"><a href={`/admin/people?edit=${item.id}`} class="underline">Editar</a><form method="post" action="/api/admin/people"><input type="hidden" name="_action" value="delete" /><input type="hidden" name="id" value={item.id} /><button class="text-red-700 underline" type="submit">Eliminar</button></form></div></article>)}</section></main></body></html>