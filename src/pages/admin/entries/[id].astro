---
import '../../../styles/global.css';
import { getBusinessContext } from '../../../lib/admin/business';
import type { Entry, EntryTranslation } from '../../../types/database';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const context = user && supabase ? await getBusinessContext(supabase, user, Astro.cookies) : { active: null, memberships: [] };
const { data: entryData } = context.active && supabase ? await supabase.from('entries').select('*').eq('id', Astro.params.id ?? '').eq('business_id', context.active.business_id).maybeSingle() : { data: null };
const entry = entryData as unknown as Entry | null;
if (!entry) return Astro.redirect('/admin/entries');
const { data: translationData } = supabase ? await supabase.from('entry_translations').select('*').eq('entry_id', entry.id).eq('locale', 'en').maybeSingle() : { data: null };
const translation = translationData as unknown as EntryTranslation | null;
---

<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Editar contenido | Administración</title></head><body class="min-h-screen bg-stone-100 text-stone-900"><main class="mx-auto max-w-3xl px-6 py-10"><a href="/admin/entries" class="text-sm text-stone-500">← Contenido</a><h1 class="mt-2 text-4xl font-medium">Editar contenido</h1><form method="post" action="/api/admin/entries" class="mt-8 space-y-5 border border-stone-300 bg-white p-6"><input type="hidden" name="id" value={entry.id} /><label class="block text-sm">Título<input required name="title" value={entry.title} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Slug<input required name="slug" value={entry.slug} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Tipo<select name="type" class="mt-2 block w-full border border-stone-300 px-3 py-2">{['project','competition','travel','publication'].map((type) => <option value={type} selected={entry.type === type}>{type}</option>)}</select></label><label class="block text-sm">Descripción<textarea name="description" rows="5" class="mt-2 block w-full border border-stone-300 px-3 py-2">{entry.description ?? ''}</textarea></label><fieldset class="space-y-4 border-t border-stone-200 pt-5"><legend class="font-medium">Versión en inglés (opcional)</legend><label class="block text-sm">Título en inglés<input name="en_title" value={translation?.title ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Slug en inglés<input name="en_slug" value={translation?.slug ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Descripción en inglés<textarea name="en_description" rows="3" class="mt-2 block w-full border border-stone-300 px-3 py-2">{translation?.description ?? ''}</textarea></label><label class="block text-sm">Ubicación en inglés<input name="en_location" value={translation?.location ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label></fieldset><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm">Ubicación<input name="location" value={entry.location ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Fecha<input name="date" type="date" value={entry.date ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label></div><label class="block text-sm">Link externo<input name="external_url" type="url" value={entry.external_url ?? ''} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Orden<input name="sort_order" type="number" value={entry.sort_order} class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><div class="flex gap-5 text-sm"><label><input name="published" type="checkbox" checked={entry.published} /> Publicado</label><label><input name="featured" type="checkbox" checked={entry.featured} /> Destacado</label></div><button class="bg-stone-900 px-4 py-3 text-white" type="submit">Guardar cambios</button></form></main></body></html>