---
import '../../../styles/global.css';
const error = Astro.url.searchParams.get('error');
---

<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Nuevo contenido | Administración</title></head><body class="min-h-screen bg-stone-100 text-stone-900"><main class="mx-auto max-w-3xl px-6 py-10"><a href="/admin/entries" class="text-sm text-stone-500">← Contenido</a><h1 class="mt-2 text-4xl font-medium">Nuevo contenido</h1>{error && <p class="mt-4 text-red-700">Completá título y tipo válido.</p>}<form method="post" action="/api/admin/entries" class="mt-8 space-y-5 border border-stone-300 bg-white p-6"><label class="block text-sm">Título<input required name="title" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Slug<input name="slug" class="mt-2 block w-full border border-stone-300 px-3 py-2" placeholder="se-genera-del-titulo" /></label><label class="block text-sm">Tipo<select name="type" class="mt-2 block w-full border border-stone-300 px-3 py-2">{['project','competition','travel','publication'].map((type) => <option value={type}>{type}</option>)}</select></label><label class="block text-sm">Descripción<textarea name="description" rows="5" class="mt-2 block w-full border border-stone-300 px-3 py-2"></textarea></label><fieldset class="space-y-4 border-t border-stone-200 pt-5"><legend class="font-medium">Versión en inglés (opcional)</legend><label class="block text-sm">Título en inglés<input name="en_title" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Slug en inglés<input name="en_slug" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Descripción en inglés<textarea name="en_description" rows="3" class="mt-2 block w-full border border-stone-300 px-3 py-2"></textarea></label><label class="block text-sm">Ubicación en inglés<input name="en_location" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label></fieldset><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm">Ubicación<input name="location" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Fecha<input name="date" type="date" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label></div><label class="block text-sm">Link externo<input name="external_url" type="url" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><label class="block text-sm">Orden<input name="sort_order" type="number" value="0" class="mt-2 block w-full border border-stone-300 px-3 py-2" /></label><div class="flex gap-5 text-sm"><label><input name="published" type="checkbox" /> Publicado</label><label><input name="featured" type="checkbox" /> Destacado</label></div><button class="bg-stone-900 px-4 py-3 text-white" type="submit">Guardar contenido</button></form></main></body></html>